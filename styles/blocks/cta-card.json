{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Aufruf-Karte (CTA)",
	"slug": "cta-card",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"border": {
			"radius": "8px"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|60",
				"bottom": "var:preset|spacing|60",
				"left": "var:preset|spacing|60",
				"right": "var:preset|spacing|60"
			}
		},
		"css": "&{background-image:var(--fck-bars);background-repeat:no-repeat;background-position:right bottom;background-size:auto 80%;}"
	}
}
