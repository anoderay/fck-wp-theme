{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Hintergrund",
					"color": "#FFFFFF"
				},
				{
					"slug": "contrast",
					"name": "Dunkel",
					"color": "#14161A"
				},
				{
					"slug": "accent-1",
					"name": "Akzent (Orange) – PLATZHALTER",
					"color": "#F26B1D"
				},
				{
					"slug": "accent-2",
					"name": "Akzent dunkel – PLATZHALTER",
					"color": "#C9540F"
				},
				{
					"slug": "accent-3",
					"name": "Akzent hell – PLATZHALTER",
					"color": "#FFE7D6"
				},
				{
					"slug": "accent-4",
					"name": "Grau dunkel",
					"color": "#4A4F57"
				},
				{
					"slug": "accent-5",
					"name": "Grau hell",
					"color": "#F3F4F6"
				},
				{
					"slug": "accent-6",
					"name": "Linie",
					"color": "#D9DCE1"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"radius": "999px"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-2",
						"text": "var:preset|color|base"
					}
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent-2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			}
		},
		"blocks": {
			"core/details": {
				"border": {
					"bottom": {
						"color": "var:preset|color|accent-6",
						"width": "1px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|20",
						"bottom": "var:preset|spacing|20"
					}
				},
				"css": "& summary{cursor:pointer;font-weight:600;}"
			}
		}
	}
}
